{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(python *)",
      "Bash(pip *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(az account show)",
      "Bash(az account show *)",
      "Bash(az * list)",
      "Bash(az * list *)",
      "Bash(az * show *)",
      "Bash(az consumption *)",
      "Bash(az bicep build *)",
      "Bash(az deployment group what-if *)",
      "Bash(databricks * list)",
      "Bash(databricks * list *)",
      "Bash(databricks * get *)",
      "Bash(databricks bundle validate *)",
      "Bash(terraform fmt *)",
      "Bash(terraform validate *)",
      "Bash(terraform plan *)",
      "PowerShell(python *)",
      "PowerShell(az account show)",
      "PowerShell(az * list *)",
      "PowerShell(az * show *)",
      "PowerShell(az consumption *)",
      "PowerShell(databricks * list *)",
      "WebSearch",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:azure.microsoft.com)",
      "WebFetch(domain:docs.databricks.com)",
      "WebFetch(domain:www.databricks.com)"
    ],
    "ask": [
      "Bash(az * create *)",
      "Bash(az * delete *)",
      "Bash(az * start *)",
      "Bash(az * scale *)",
      "Bash(az deployment group create *)",
      "Bash(az deployment sub create *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(databricks clusters create *)",
      "Bash(databricks clusters start *)",
      "Bash(databricks jobs run-now *)",
      "Bash(databricks jobs submit *)",
      "Bash(databricks bundle deploy *)",
      "Bash(databricks bundle run *)",
      "Bash(azcopy *)",
      "Bash(git push)",
      "Bash(git push *)",
      "PowerShell(az * create *)",
      "PowerShell(az * delete *)",
      "PowerShell(az * start *)",
      "PowerShell(az deployment *)",
      "PowerShell(terraform apply *)",
      "PowerShell(terraform destroy *)",
      "PowerShell(databricks clusters *)",
      "PowerShell(databricks jobs *)",
      "PowerShell(databricks bundle *)",
      "PowerShell(azcopy *)",
      "PowerShell(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Edit(./.env)",
      "Edit(./**/.env)"
    ]
  }
}
